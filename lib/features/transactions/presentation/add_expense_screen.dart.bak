import 'package:flutter/material.dart';
import 'package:lucide_icons/lucide_icons.dart';
import '../../../core/theme/app_colors.dart';
import '../../../core/widgets/glass_card.dart';
import '../../../core/providers/settings_provider.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

class AddExpenseScreen extends ConsumerWidget {
  const AddExpenseScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final currency = ref.watch(currencySymbolProvider);
    final rate = ref.watch(currencyRateProvider);
    return Scaffold(
      appBar: AppBar(
        leading: IconButton(
          icon: const Icon(LucideIcons.chevronLeft),
          onPressed: () => Navigator.pop(context),
        ),
        title: const Text('Add Expense', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
        actions: [
          IconButton(icon: const Icon(LucideIcons.moreVertical), onPressed: () {}),
        ],
      ),
      body: Column(
        children: [
          Expanded(
            child: ListView(
              padding: const EdgeInsets.all(16.0),
              children: [
                _buildAmountCard(),
                const SizedBox(height: 24),
                _buildWalletSelector(),
                const SizedBox(height: 24),
                _buildForm(),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(16.0),
            child: SizedBox(
              width: double.infinity,
              height: 56,
              child: ElevatedButton(
                onPressed: () {},
                child: const Text('Save Expense', style: TextStyle(color: AppColors.background, fontSize: 16, fontWeight: FontWeight.bold)),
              ),
            ),
          )
        ],
      ),
    );
  }

  Widget _buildAmountCard() {
    return GlassCard(
      padding: EdgeInsets.zero,
      child: Row(
        children: [
          Expanded(
            child: Padding(
              padding: const EdgeInsets.all(20.0),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('Total', style: TextStyle(color: AppColors.textSecondary, fontSize: 16)),
                  const SizedBox(height: 12),
                  Text(
                    '${currency}${(250.00 * rate).toStringAsFixed(2)}',
                    style: TextStyle(fontSize: 40, fontWeight: FontWeight.bold, color: Colors.white),
                  ),
                  const SizedBox(height: 20),
                  Row(
                    children: [
                      Icon(LucideIcons.calendarDays, color: AppColors.textSecondary.withOpacity(0.7), size: 16),
                      const SizedBox(width: 8),
                      const Text('Monday, 20 May 2024', style: TextStyle(color: AppColors.textSecondary, fontSize: 12)),
                      const Spacer(),
                      Icon(LucideIcons.calendar, color: AppColors.textSecondary, size: 16),
                    ],
                  ),
                  const SizedBox(height: 16),
                  Row(
                    children: [
                      Icon(LucideIcons.wallet, color: AppColors.textSecondary.withOpacity(0.7), size: 16),
                      const SizedBox(width: 8),
                      const Text('Wallet', style: TextStyle(color: AppColors.textSecondary, fontSize: 12)),
                      const Spacer(),
                      Icon(LucideIcons.chevronDown, color: AppColors.textSecondary, size: 16),
                    ],
                  )
                ],
              ),
            ),
          ),
          // Vertical slider placeholder
          Container(
            width: 80,
            decoration: BoxDecoration(
              color: AppColors.cardBackground.withOpacity(0.5),
              border: Border(left: BorderSide(color: AppColors.borderLight.withOpacity(0.05))),
            ),
            child: Center(
              child: Container(
                width: 32,
                height: 120,
                decoration: BoxDecoration(
                  color: AppColors.primary.withOpacity(0.9),
                  borderRadius: BorderRadius.circular(16),
                  boxShadow: const [
                    BoxShadow(color: AppColors.primaryGlow, blurRadius: 12)
                  ]
                ),
                child: const Center(
                  child: Text('${currency}', style: TextStyle(color: AppColors.background, fontSize: 18, fontWeight: FontWeight.bold)),
                ),
              ),
            ),
          )
        ],
      ),
    );
  }

  Widget _buildWalletSelector() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
      decoration: BoxDecoration(
        color: AppColors.cardBackground,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: AppColors.borderLight.withOpacity(0.05)),
      ),
      child: Row(
        children: [
          const Text('Wallet', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
          const SizedBox(width: 16),
          Container(
            width: 32,
            height: 24,
            decoration: BoxDecoration(
              color: AppColors.bottomNavBackground,
              borderRadius: BorderRadius.circular(4),
            ),
            child: const Center(
              child: Icon(Icons.circle, color: AppColors.primary, size: 8),
            ),
          ),
          const SizedBox(width: 8),
          // MasterCard logo mock
          Row(
            children: [
              Container(width: 16, height: 16, decoration: BoxDecoration(color: Colors.red.withOpacity(0.8), shape: BoxShape.circle)),
              Transform.translate(
                offset: const Offset(-6, 0),
                child: Container(width: 16, height: 16, decoration: BoxDecoration(color: Colors.orange.withOpacity(0.8), shape: BoxShape.circle)),
              ),
            ],
          ),
          const SizedBox(width: 8),
          const Text('Visa Card', style: TextStyle(color: AppColors.textSecondary, fontSize: 14)),
        ],
      ),
    );
  }

  Widget _buildForm() {
    return Column(
      children: [
        _buildFormField('Expense Category', 'Food & Dining', showTrailing: true),
        _buildFormField('Description', 'Lunch with John'),
        _buildFormField('Amount', '${currency}${(250.00 * rate).toStringAsFixed(2)}'),
        _buildFormField('Date', '20 May 2024'),
        _buildFormField('Note', 'Business lunch'),
        _buildFormField('Receipt', '', icon: LucideIcons.camera),
      ],
    );
  }

  Widget _buildFormField(String label, String value, {bool showTrailing = false, IconData? icon}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 16.0),
      child: Row(
        children: [
          Text(label, style: const TextStyle(color: AppColors.textSecondary, fontSize: 14)),
          const Spacer(),
          if (value.isNotEmpty) Text(value, style: const TextStyle(color: Colors.white, fontSize: 14)),
          if (showTrailing) ...[
            const SizedBox(width: 8),
            Icon(LucideIcons.chevronRight, color: AppColors.textSecondary, size: 16),
          ],
          if (icon != null) ...[
            const SizedBox(width: 8),
            Icon(icon, color: AppColors.textSecondary, size: 20),
          ]
        ],
      ),
    );
  }
}
